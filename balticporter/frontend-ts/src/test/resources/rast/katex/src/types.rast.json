      "comments": [
        {
          "kind": "line",
          "text": "// LaTeX argument type.",
          "pos": [
            9,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//   - \"size\": A size-like thing, such as \"1em\" or \"5ex\"",
          "pos": [
            10,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//   - \"color\": An html color, like \"#abc\" or \"blue\"",
          "pos": [
            11,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//   - \"url\": An url string, in which \"\\\" will be ignored",
          "pos": [
            12,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//   -        if it precedes [#$%&~_^\\{}]",
          "pos": [
            13,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//   - \"raw\": A string, allowing single character, percent sign,",
          "pos": [
            14,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//            and nested braces",
          "pos": [
            15,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//   - \"original\": The same type as the environment that the",
          "pos": [
            16,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//                 function being parsed is in (e.g. used for the",
          "pos": [
            17,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//                 bodies of functions like \\textcolor where the",
          "pos": [
            18,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//                 first argument is special and the second",
          "pos": [
            19,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//                 argument is parsed normally)",
          "pos": [
            20,
            1
          ]
        },
        {
          "kind": "line",
          "text": "//   - Mode: Node group parsed in given mode.",
          "pos": [
            21,
            1
          ]
        }
      ],
