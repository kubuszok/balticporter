package ssg
package mermaid
package diagrams
package architecture

import ssg.mermaid.theme.ThemeVariables

/** CSS class generation for architecture diagram elements. */
object ArchitectureStyles {

  def generate(vars: ThemeVariables): String =
    s""".archService {
       |  fill: ${vars.mainBkg};
       |  stroke: ${vars.nodeBorder};
       |  stroke-width: 1px;
       |}
       |.archJunction {
       |  fill: ${vars.lineColor};
       |  stroke: none;
       |}
       |.archLabel {
       |  font-size: 12px;
       |  fill: ${vars.textColor};
       |  font-family: ${vars.fontFamily};
       |}
       |.archEdge {
       |  stroke: ${vars.lineColor};
       |  stroke-width: 1.5px;
       |}
       |.archEdgeLabel {
       |  font-size: 10px;
       |  fill: ${vars.textColor};
       |  font-family: ${vars.fontFamily};
       |}
       |""".stripMargin
}
