package ssg
package mermaid
package diagrams
package packet

import ssg.mermaid.theme.ThemeVariables

/** CSS class generation for packet diagram elements. */
object PacketStyles {

  def generate(vars: ThemeVariables): String =
    s""".packetTitle {
       |  font-size: 16px;
       |  fill: ${vars.textColor};
       |  font-family: ${vars.fontFamily};
       |}
       |.packetBitLabel {
       |  font-size: 10px;
       |  fill: ${vars.textColor};
       |  font-family: ${vars.fontFamily};
       |}
       |.packetField {
       |  fill: ${vars.mainBkg};
       |  stroke: ${vars.nodeBorder};
       |  stroke-width: 1px;
       |}
       |.packetFieldLabel {
       |  font-size: 12px;
       |  fill: ${vars.textColor};
       |  font-family: ${vars.fontFamily};
       |}
       |""".stripMargin
}
